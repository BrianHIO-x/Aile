*.p7b
*.cer
*.csr
*.jks
*.keystore

# ---- 日志与崩溃记录 ----
*.log
hs_err_pid*

# ---- 脚本缓存 ----
__pycache__/
*.pyc

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
